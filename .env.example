# Copy to .env to run the bot on your own computer (.env is gitignored).
# On a VPS, deploy/install.sh asks for these and saves them to /etc/lurkme/lurkme.env.
# See README.md for how to get each value.

# Your Twitch app (dev.twitch.tv/console/apps)
CLIENT_ID=
CLIENT_SECRET=

# User token + refresh token generated with the app above
# (scopes: chat:read user:read:follows)
OAUTH_TOKEN=
REFRESH_TOKEN=

# Optional (comma-separated) — see README.md
# CHANNELS=streamer1, streamer2
# STREAM_LANGUAGES=en
# CATEGORIES=Just Chatting

# Auto-join every chatter's own channel, including offline channels.
# Saved channels survive refreshes/restarts. 0 removes the application's cap.
# AUTO_JOIN_MODE=all
# MAX_CHANNELS=0
# AUTO_JOIN_FILE=/var/lib/lurkme/auto_channels.sqlite3

# Optional Discord gift alerts. Keep the webhook URL private.
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# DISCORD_USER_ID=123456789012345678
